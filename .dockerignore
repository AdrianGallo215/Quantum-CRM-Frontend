# Todo lo que no haga falta para construir el bundle. Reduce el contexto que se
# envía al daemon (más rápido) y, sobre todo, evita que .env o dist/ del equipo
# de desarrollo acaben dentro de la imagen.

node_modules
dist
.git
.gitignore

# Los secretos y la configuración local NUNCA entran en la imagen: las variables
# de producción llegan por --build-arg.
.env
.env.*
!.env.example
*.local

# Documentación, prototipos y notas de trabajo: no forman parte del artefacto.
docs
*.md
!README.md
.claude
.mcp.json
.playwright-mcp

# Editores y sistema operativo
.vscode
.idea
.DS_Store
Thumbs.db

# Artefactos del propio Docker
Dockerfile
.dockerignore
docker-compose*.yml
