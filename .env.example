# Copia este archivo a `.env` (desarrollo) y ajusta los valores.
#
# ⚠️ Vite INCRUSTA estas variables en el bundle en tiempo de BUILD, no las lee
# al arrancar el contenedor. El bundle es público: nunca pongas secretos aquí.
# En Docker se pasan como --build-arg (ver Dockerfile).

# Base de la API REST, incluyendo /api/v1.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Cotizador (sistema externo). OPCIONAL: si se deja vacía se usa el servidor por
# defecto (http://quantum.okserver43.com/...), definido en CotizadorFab.tsx.
# Solo hace falta para apuntar a otro servidor sin recompilar.
VITE_COTIZADOR_URL=
